---
import Layout from '../components/Layout.astro';
import { SECTIONS, SECTION_META } from '../sections.mjs';
---

<Layout title="Not found" description="That page doesn't exist.">
  <section class="max-w-2xl py-12">
    <p class="font-mono text-sm text-ink-4 mb-3">404</p>
    <h1 class="text-3xl sm:text-4xl font-bold mb-3">That page doesn't exist</h1>
    <p class="text-ink-3 leading-relaxed mb-8">
      The link may be stale, or the entry may have been renamed. Try a section, or search from the
      header.
    </p>
    <div class="flex flex-wrap gap-2">
      <a href="/" class="px-4 py-2 rounded-md bg-accent/15 border border-accent/30 text-accent-2 hover:bg-accent/25 transition-colors text-sm font-medium">
        Home
      </a>
      {SECTIONS.map(section => (
        <a href={`/${section}`} class="px-4 py-2 rounded-md bg-ink/5 border border-line text-ink-2 hover:bg-ink/10 transition-colors text-sm">
          {SECTION_META[section].label}
        </a>
      ))}
    </div>
  </section>
</Layout>
