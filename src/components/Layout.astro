---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SearchBar from './SearchBar.astro';
import { SECTIONS, SECTION_META } from '../sections.mjs';

interface Props {
  title: string;
  description?: string;
  /** 'article' adds article OG tags — use for entry pages. */
  ogType?: 'website' | 'article';
  publishedDate?: string;
  modifiedDate?: string;
}

const {
  title,
  description = 'Security research, engineering notes, and long-form writing by mart1n.',
  ogType = 'website',
  publishedDate,
  modifiedDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);
const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);

const navLink = (path: string) =>
  `px-2.5 py-1.5 rounded-md transition-colors ${
    isActive(path) ? 'text-ink bg-ink/5' : 'text-ink-3 hover:text-ink hover:bg-ink/5'
  }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Pre-paint theme init — must run before first render to avoid a flash.
      (() => {
        let t;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="mart1n" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogType === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {ogType === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Must track the --c-accent / --c-page tokens in global.css. -->
    <link rel="mask-icon" href="/favicon.svg" color="#0d7d6e" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c1512" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f9f8" />
    <link rel="alternate" type="application/rss+xml" title="mart1n" href={new URL('/rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title === 'mart1n' ? 'mart1n — writing & research' : `${title} | mart1n`}</title>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-elevated focus:text-ink focus:px-3 focus:py-2 focus:rounded">
      Skip to content
    </a>
    <header class="sticky top-0 z-40 border-b border-line bg-page/80 backdrop-blur-md backdrop-saturate-150">
      <div class="g-accent-strip"></div>
      <nav class="container mx-auto px-4 h-14 flex items-center justify-between gap-3 sm:gap-4">
        <a href="/" class="flex items-baseline gap-2 shrink-0 group">
          <span class="font-serif text-2xl font-semibold text-ink group-hover:text-accent-2 transition-colors leading-none">mart1n</span>
          <span class="hidden sm:inline g-label text-ink-4 leading-none">writing</span>
        </a>
        <div class="flex-1 min-w-0 max-w-md">
          <SearchBar />
        </div>
        <div class="flex items-center gap-1 text-sm shrink-0">
          {SECTIONS.map(section => (
            <a href={`/${section}`} class={`hidden md:inline-block ${navLink(`/${section}`)}`}>
              {SECTION_META[section].label}
            </a>
          ))}
          <a href="/about" class={`hidden sm:inline-block ${navLink('/about')}`}>About</a>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            class="p-2 rounded-md text-ink-3 hover:text-ink hover:bg-ink/5 transition-colors"
          >
            <!-- sun: shown in dark mode (click → light) -->
            <svg class="theme-icon-sun w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <!-- moon: shown in light mode (click → dark) -->
            <svg class="theme-icon-moon w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>
    <main id="main" class="container mx-auto px-4 py-10 relative">
      <slot />
    </main>
    <footer class="border-t border-line bg-page/50 mt-20">
      <div class="container mx-auto px-4 py-10">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-5">
          <a href="/" class="font-serif text-xl font-semibold text-ink-2 hover:text-accent-2 transition-colors">
            mart1n
          </a>
          <nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-ink-3">
            {SECTIONS.map(section => (
              <a href={`/${section}`} class="hover:text-ink transition-colors">{SECTION_META[section].label}</a>
            ))}
            <a href="/about" class="hover:text-ink transition-colors">About</a>
            <a href="/rss.xml" class="hover:text-ink transition-colors">RSS</a>
            <a href="https://github.com/mart1n2" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">GitHub ↗</a>
          </nav>
        </div>
        <div class="mt-8 pt-6 border-t border-line flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-ink-4">
          <span class="g-label">Elsewhere</span>
          <a href="https://www.kyp.one" target="_blank" rel="noopener noreferrer" class="hover:text-ink-2 transition-colors">
            Know Your Protocol — DeFi protocol permission database ↗
          </a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('theme-toggle');
      const apply = (t: string) => { document.documentElement.dataset.theme = t; };

      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        apply(next);
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Until the user picks explicitly, follow live OS theme changes.
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        if (stored !== 'light' && stored !== 'dark') apply(e.matches ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
